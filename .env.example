# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Vertex AI / Gemini
VERTEX_AI_LOCATION=us-central1

# Dynatrace
DT_TENANT_URL=https://your-tenant.live.dynatrace.com
DT_API_TOKEN=dt0c01.your-token-here
DT_MCP_SERVER_URL=http://localhost:3001   # or Cloud Run URL
# Webhook shared secret (run infra/setup_dynatrace_webhook.sh to generate + store in Secret Manager)
# For local dev set this directly; in production it is read from Secret Manager automatically.
DT_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

# Firestore
FIRESTORE_DATABASE=(default)

# Agent API
AGENT_API_KEY=change-me-before-deploy
AGENT_PORT=8080
# Service account email shown in audit logs (auto-detected from GCP metadata if unset)
AGENT_SERVICE_ACCOUNT=sitemedic-agent@your-project.iam.gserviceaccount.com

# Demo app (Cloud Run URLs filled in after deploy)
DEMO_APP_URL=http://localhost:3000
DEMO_APP_STABLE_REVISION=demo-app-v1-stable
DEMO_APP_BUGGY_REVISION=demo-app-v2-buggy

# Predictive loop — comma-separated Cloud Run service names to monitor.
# If unset, the predictor falls back to services seen in recent Firestore incidents.
MONITORED_SERVICES=sitemedic-demo-app

# Frontend (set in Vercel env or locally)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_AGENT_URL=http://localhost:8080
NEXT_PUBLIC_AGENT_API_KEY=change-me-before-deploy

# Agent requires this in staging/prod
FRONTEND_URL=http://localhost:3001

# Environment (required: dev | staging | prod)
ENV=dev

# Demo Mode
# SITEMEDIC_FORCE_DEMO=true   → always use DemoModeSource, skip Dynatrace health check
# SITEMEDIC_DISABLE_DEMO=true → always use DynatraceMCPSource, fail loud if down (use in staging)
# DEMO_PUBLIC=true            → disable API key auth for hosted public demo (judges URL only)
SITEMEDIC_FORCE_DEMO=false
SITEMEDIC_DISABLE_DEMO=false
DEMO_PUBLIC=false
