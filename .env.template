# SiteMedic Environment Template
# Copy to .env and fill in values
# DO NOT commit .env to version control - it may contain secrets

# Environment selection (required)
ENV=dev

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Dynatrace Configuration
DT_TENANT_URL=https://your-tenant.live.dynatrace.com
DT_API_TOKEN=dt0c01.your-token-here
DT_MCP_SERVER_URL=http://localhost:3001
DT_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

# Firestore
FIRESTORE_DATABASE=(default)

# Agent API
AGENT_API_KEY=change-me-before-deploy
AGENT_PORT=8080
AGENT_SERVICE_ACCOUNT=sitemedic-agent@your-project.iam.gserviceaccount.com

# Demo app (Cloud Run URLs filled in after deploy)
DEMO_APP_URL=http://localhost:3000
DEMO_APP_STABLE_REVISION=demo-app-v1-stable
DEMO_APP_BUGGY_REVISION=demo-app-v2-buggy

# Monitored Services
MONITORED_SERVICES=sitemedic-demo-app

# Frontend (set in Vercel env or locally)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_AGENT_URL=http://localhost:8080
NEXT_PUBLIC_AGENT_API_KEY=change-me-before-deploy

# Agent requires this in staging/prod
FRONTEND_URL=http://localhost:3001
